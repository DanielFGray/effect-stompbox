{
	"apiVersion": "roamancer/v2",
	"name": "stompbox",
	"postgres": [
		{
			"database": "stompbox_setlist",
			"extensions": ["citext", "pgcrypto", "uuid-ossp"]
		},
		{
			"database": "stompbox_setlist_base",
			"extensions": ["citext", "pgcrypto", "uuid-ossp"]
		},
		{
			"database": "stompbox_dfg_rocks",
			"extensions": ["citext", "pgcrypto", "uuid-ossp"]
		},
		{
			"database": "stompbox_dfg_rocks_base",
			"extensions": ["citext", "pgcrypto", "uuid-ossp"]
		},
		{
			"database": "stompbox_template",
			"extensions": [
				"uuid-ossp",
				"citext",
				"btree_gin",
				"pgcrypto",
				"pg_trgm",
				"fuzzystrmatch",
				"pgsodium"
			]
		},
		{
			"database": "stompbox_dfg_codes",
			"extensions": ["citext", "pgcrypto"]
		},
		{
			"database": "stompbox_visitor",
			"extensions": []
		},
		{
			"database": "stompbox_delivery",
			"extensions": []
		},
		{
			"database": "stompbox_auth",
			"extensions": ["pgsodium"]
		},
		{
			"database": "stompbox_knowledgebase_test",
			"extensions": ["citext", "pgsodium"]
		}
	],
	"services": [
		{
			"secrets": [
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_setlist",
					"login": "migration",
					"urlEnv": "CORPUS_SETLIST_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_setlist_base",
					"login": "migration",
					"urlEnv": "CORPUS_SETLIST_BASE_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_dfg_rocks",
					"login": "migration",
					"urlEnv": "CORPUS_DFG_ROCKS_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_dfg_rocks_base",
					"login": "migration",
					"urlEnv": "CORPUS_DFG_ROCKS_BASE_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_template",
					"login": "migration",
					"urlEnv": "CORPUS_TEMPLATE_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_dfg_codes",
					"login": "migration",
					"urlEnv": "CORPUS_DFG_CODES_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_visitor",
					"login": "migration",
					"urlEnv": "VISITOR_OWNER_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_visitor",
					"login": "api",
					"urlEnv": "VISITOR_API_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_delivery",
					"login": "migration",
					"urlEnv": "DELIVERY_OWNER_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_delivery",
					"login": "api",
					"urlEnv": "DELIVERY_API_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_auth",
					"login": "migration",
					"urlEnv": "AUTH_OWNER_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_auth",
					"login": "api",
					"urlEnv": "AUTH_API_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_knowledgebase_test",
					"login": "migration",
					"urlEnv": "KNOWLEDGEBASE_DATABASE_URL"
				},
				{
					"_tag": "PostgresCredentials",
					"database": "stompbox_knowledgebase_test",
					"login": "api",
					"urlEnv": "KNOWLEDGEBASE_AUTH_DATABASE_URL"
				}
			]
		}
	]
}
