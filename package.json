{
	"name": "@danielfgray/stompbox",
	"version": "0.1.1",
	"workspaces": [
		"examples/*"
	],
	"files": [
		"dist"
	],
	"type": "module",
	"sideEffects": false,
	"exports": {
		"./auth": {
			"stompbox-source": "./src/auth/index.ts",
			"types": "./dist/auth/index.d.ts",
			"default": "./dist/auth/index.js"
		},
		"./auth/api": {
			"stompbox-source": "./src/auth/api.ts",
			"types": "./dist/auth/api.d.ts",
			"default": "./dist/auth/api.js"
		},
		"./auth/http": {
			"stompbox-source": "./src/auth/http.ts",
			"types": "./dist/auth/http.d.ts",
			"default": "./dist/auth/http.js"
		},
		"./checker": {
			"stompbox-source": "./src/checker/index.ts",
			"types": "./dist/checker/index.d.ts",
			"default": "./dist/checker/index.js"
		},
		"./db": {
			"stompbox-source": "./src/db/index.ts",
			"types": "./dist/db/index.d.ts",
			"default": "./dist/db/index.js"
		},
		"./delivery": {
			"stompbox-source": "./src/delivery/index.ts",
			"types": "./dist/delivery/index.d.ts",
			"default": "./dist/delivery/index.js"
		},
		"./http": {
			"stompbox-source": "./src/http/index.ts",
			"types": "./dist/http/index.d.ts",
			"default": "./dist/http/index.js"
		},
		"./http/server": {
			"stompbox-source": "./src/http/server/index.ts",
			"types": "./dist/http/server/index.d.ts",
			"default": "./dist/http/server/index.js"
		},
		"./http/client": {
			"stompbox-source": "./src/http/client/index.ts",
			"types": "./dist/http/client/index.d.ts",
			"default": "./dist/http/client/index.js"
		},
		"./testing": {
			"stompbox-source": "./src/testing/index.ts",
			"types": "./dist/testing/index.d.ts",
			"default": "./dist/testing/index.js"
		},
		"./worker": {
			"stompbox-source": "./src/worker/index.ts",
			"types": "./dist/worker/index.d.ts",
			"default": "./dist/worker/index.js"
		},
		"./visitor": {
			"stompbox-source": "./src/visitor/index.ts",
			"types": "./dist/visitor/index.d.ts",
			"default": "./dist/visitor/index.js"
		}
	},
	"scripts": {
		"build": "bun scripts/build.ts",
		"typecheck": "tsc --noEmit",
		"lint": "oxlint --type-aware",
		"fmt": "oxfmt .",
		"fmt:check": "oxfmt --check .",
		"prepare": "effect-tsgo patch --typescript --oxlint",
		"test": "bun --bun vitest run",
		"release": "bun scripts/release.ts"
	},
	"devDependencies": {
		"@effect/platform-bun": "4.1.1",
		"@effect/sql-pg": "4.1.1",
		"@effect/tsgo": "0.63.0",
		"@effect/vitest": "4.1.1",
		"@types/bun": "^1.4.4",
		"effect": "4.1.1",
		"graphile-worker": "0.18.0",
		"kysely": "0.29.4",
		"oxfmt": "^0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"typescript": "7.0.2",
		"vitest": "^5.0.5"
	},
	"peerDependencies": {
		"@effect/platform-bun": "^4.1.0",
		"@effect/sql-pg": "^4.1.0",
		"effect": "^4.1.0",
		"graphile-worker": "^0.18.0",
		"kysely": "^0.29.4"
	},
	"peerDependenciesMeta": {
		"@effect/platform-bun": {
			"optional": true
		},
		"@effect/sql-pg": {
			"optional": true
		},
		"graphile-worker": {
			"optional": true
		},
		"kysely": {
			"optional": true
		}
	}
}
